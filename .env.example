# Copy to .env and adjust. Never commit .env — see .gitignore.
# All settings are read by src/udt/common/config.py (prefix UDT_).

UDT_ENVIRONMENT=dev
UDT_LOG_LEVEL=INFO

UDT_POSTGRES_HOST=localhost
UDT_POSTGRES_PORT=5432
UDT_POSTGRES_DB=udt
UDT_POSTGRES_USER=udt
UDT_POSTGRES_PASSWORD=udt

UDT_DEFAULT_SEED=0

# M9b (LLM planning layer). Get a key at https://console.anthropic.com/ —
# leave unset (the default) to keep using scripted/recorded LLMClients
# only; `llm/anthropic_client.py`'s AnthropicLLMClient needs this set to
# make any real, billed API call.
# UDT_LLM_API_KEY=
UDT_LLM_MODEL=claude-sonnet-5
UDT_LLM_MAX_TOKENS_PER_DECISION=20000
